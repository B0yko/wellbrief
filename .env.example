# Example environment configuration for wellbrief.
#
# Copy to .env and edit as needed, or export these directly in your shell. Never commit a real
# .env file or a real API key; .env is gitignored. Every command works with none of these set at
# all, using the defaults shown below.

# Workspace location: $WELLBRIEF_HOME/<workspace>/ holds the SQLite store, per-field indexes,
# and the audit/egress logs.
WELLBRIEF_HOME=~/.wellbrief
WELLBRIEF_WORKSPACE=default

# All-in day rate (rig + every service on location), used for every NPT cost figure. Illustrative
# default; set this to your own field's actual spread rate.
WELLBRIEF_SPREAD_RATE_USD_PER_DAY=48000

# Narrator selection: "offline" (default, deterministic, no network) or "llm".
WELLBRIEF_NARRATOR=offline

# --- Only read when WELLBRIEF_NARRATOR=llm (or --narrator llm) ---

# Base URL of any OpenAI-compatible /chat/completions server. A loopback address (mlx_lm.server,
# llama-server) needs nothing else below; a non-loopback host (e.g. OpenRouter) is refused unless
# WELLBRIEF_ALLOW_REMOTE=1 is also set.
# WELLBRIEF_LLM_BASE_URL=http://127.0.0.1:8901/v1
# WELLBRIEF_LLM_MODEL=mlx-community/Qwen3-0.6B-4bit

# Example for a hosted, OpenAI-compatible router instead of a local server:
# WELLBRIEF_LLM_BASE_URL=https://openrouter.ai/api/v1
# WELLBRIEF_LLM_MODEL=qwen/qwen-2.5-7b-instruct
# WELLBRIEF_LLM_API_KEY=REPLACE_WITH_YOUR_OWN_KEY
# WELLBRIEF_ALLOW_REMOTE=1

# Per-workspace spend cap in USD before a call is refused (cumulative, tracked in egress.jsonl).
WELLBRIEF_BUDGET_USD=10

# Used only when the server's response carries no provider-reported cost.
# WELLBRIEF_LLM_PRICE_IN_PER_MTOK=0.10
# WELLBRIEF_LLM_PRICE_OUT_PER_MTOK=0.20

# A custom CA bundle (PEM file), replacing the system trust store for HTTPS to the LLM server.
# WELLBRIEF_CA_BUNDLE=/path/to/ca-bundle.pem
